            "api",
            "estado"
          ]
        },
        "description": "Confirma que el microservicio del foro responde. Son dos servicios distintos, en puertos distintos, contra el mismo esquema de Oracle."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('es el otro microservicio', () => pm.expect(d.servicio).to.eql('foro-temas'));",
              "pm.test('conectado a la base de datos', () => pm.expect(d.baseDeDatos.conectada).to.be.true);"
            ]
          }
        }
      ]
    },
