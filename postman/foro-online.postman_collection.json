    {
      "name": "07 - POST registro de un usuario nuevo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreUsuario\": \"cubero.demo\",\n  \"correo\": \"cubero.demo@foro.cl\",\n  \"contrasena\": \"Cubo12345*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{urlUsuarios}}/api/usuarios",
          "host": [
            "{{urlUsuarios}}"
          ],
          "path": [
            "api",
            "usuarios"
          ]
        },
        "description": "Alta de cuenta. Es publico y la respuesta nunca incluye la contrasena ni su hash. El usuario queda con el rol USUARIO."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const d = pm.response.json();",
              "pm.test('rol USUARIO por omision', () => pm.expect(d.roles).to.eql(['USUARIO']));",
              "pm.test('no devuelve la contrasena', () => {",
              "    const texto = pm.response.text();",
              "    pm.expect(texto).to.not.include('Cubo12345');",
              "    pm.expect(texto).to.not.include('$2a$');",
              "});",
              "pm.collectionVariables.set('idUsuario', d.id);"
            ]
          }
        }
      ]
    },
